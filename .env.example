# Copia este archivo como .env y llena tus valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Llave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambia-esto-por-una-llave-secreta

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Credenciales gratuitas de IGDB (Twitch): https://dev.twitch.tv/console/apps
# Si las dejas vacías la página funciona en modo demo
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
